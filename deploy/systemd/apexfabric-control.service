[Unit]
Description=ApexFabric local site control service
After=k3s.service apexfabric-node-provision.service
Wants=k3s.service apexfabric-node-provision.service

[Service]
Type=simple
User=root
WorkingDirectory=__REPO_ROOT__
Environment=APEXFABRIC_STATE_DIR=/var/lib/apexfabric/control
Environment=APEXFABRIC_REGISTRY_ADDRESS=__APEXFABRIC_REGISTRY__
Environment=APEXFABRIC_TELEMETRY_MAX_BYTES=41943040
Environment=APEXFABRIC_TELEMETRY_HIGH_WATERMARK=0.90
Environment=APEXFABRIC_TELEMETRY_LOW_WATERMARK=0.80
Environment=APEXFABRIC_TELEMETRY_MAX_AGE_SECONDS=1209600
Environment=APEXFABRIC_TELEMETRY_MAX_EVENTS=1000000
Environment=APEXFABRIC_TELEMETRY_MAX_SNAPSHOT_BYTES=20971520
Environment=APEXFABRIC_TELEMETRY_MAX_EVENT_BYTES=1048576
Environment=APEXFABRIC_TELEMETRY_MAX_SNAPSHOTS_PER_EVENT=16
Environment=APEXFABRIC_TELEMETRY_MIN_FREE_BYTES=5368709120
WorkingDirectory=__REPO_ROOT__
ExecStart=/usr/bin/python3 -m apexfabric.control_plane.server --host 127.0.0.1 --port 8088 --state-dir /var/lib/apexfabric/control
Restart=on-failure
RestartSec=3
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
