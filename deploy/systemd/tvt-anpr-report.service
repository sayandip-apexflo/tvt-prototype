[Unit]
Description=Send the TVT daily ANPR duration report
After=network-online.target tvt-anpr-report-collector.service
Wants=network-online.target

[Service]
Type=oneshot
User=tvt-report
Group=tvt-report
EnvironmentFile=/etc/tvt/anpr-report.env
ExecStart=/opt/tvt/venv/bin/tvt-anpr-report send-daily
NoNewPrivileges=true
PrivateDevices=true
PrivateTmp=true
ProtectClock=true
ProtectHome=true
ProtectHostname=true
ProtectSystem=strict
ProtectKernelLogs=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
RestrictNamespaces=true
RestrictRealtime=true
RestrictSUIDSGID=true
LockPersonality=true
MemoryDenyWriteExecute=true
RemoveIPC=true
ReadWritePaths=/var/lib/tvt-reporting
SystemCallArchitectures=native
UMask=0077
