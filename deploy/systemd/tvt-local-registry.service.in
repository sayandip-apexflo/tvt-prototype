[Unit]
Description=TVT edge-local OCI registry
Requires=docker.service
After=docker.service
Before=k3s.service

[Service]
Type=simple
ExecStartPre=-/usr/bin/docker rm --force tvt-local-registry
ExecStart=/usr/bin/docker run --name tvt-local-registry --pull=never --publish 127.0.0.1:5000:5000 --volume /var/lib/tvt/registry:/var/lib/registry --read-only --tmpfs /tmp:rw,noexec,nosuid,size=16m --cap-drop ALL --security-opt no-new-privileges=true __TVT_LOCAL_REGISTRY_IMAGE__
ExecStartPost=/usr/bin/curl --fail --silent --show-error --retry 29 --retry-delay 1 --retry-connrefused --max-time 2 --retry-max-time 30 http://127.0.0.1:5000/v2/
ExecStop=-/usr/bin/docker stop --time 30 tvt-local-registry
ExecStopPost=-/usr/bin/docker rm --force tvt-local-registry
Restart=on-failure
RestartSec=5s
TimeoutStartSec=45s
TimeoutStopSec=45s
NoNewPrivileges=true
PrivateDevices=true
PrivateTmp=true
ProtectClock=true
ProtectControlGroups=true
ProtectHome=true
ProtectHostname=true
ProtectKernelLogs=true
ProtectKernelModules=true
ProtectKernelTunables=true
ProtectSystem=strict
RestrictAddressFamilies=AF_UNIX AF_INET
RestrictNamespaces=true
RestrictRealtime=true
RestrictSUIDSGID=true
LockPersonality=true
MemoryDenyWriteExecute=true
SystemCallArchitectures=native
IPAddressDeny=any
IPAddressAllow=localhost
UMask=0027

[Install]
WantedBy=multi-user.target
