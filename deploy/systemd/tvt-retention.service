[Unit]
Description=Apply TVT management database retention
After=postgresql.service

[Service]
Type=oneshot
User=tvt-edge
Group=tvt-edge
EnvironmentFile=-/etc/tvt/edge.env
ExecStart=/opt/tvt/venv/bin/tvt-edge retention
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
UMask=0077
