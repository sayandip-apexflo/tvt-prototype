# Non-secret TVT service settings. The default PostgreSQL URL uses the local
# Unix socket and peer authentication for the tvt-edge OS/database role.
TVT_DATABASE_URL=postgresql+psycopg:///tvt
TVT_CREDENTIAL_KEY_DIR=/etc/tvt/credential-keys
TVT_LISTEN_HOST=127.0.0.1
TVT_LISTEN_PORT=8088
TVT_KUBECONFIG=/etc/tvt/kubeconfig
TVT_SYNC_NAMESPACE=apexfabric
TVT_SYNC_WORKER_ID=tvt-edge
TVT_ROLLOUT_TIMEOUT=180
