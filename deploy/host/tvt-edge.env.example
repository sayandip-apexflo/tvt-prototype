# Non-secret TVT service settings. The default PostgreSQL URL uses the local
# Unix socket and peer authentication for the tvt-edge OS/database role.
TVT_DATABASE_URL=postgresql+psycopg:///tvt
TVT_CREDENTIAL_KEY_DIR=/etc/tvt/credential-keys
TVT_LISTEN_HOST=127.0.0.1
TVT_LISTEN_PORT=8089
# Use the dedicated host/management address reachable from K3s Pods in
# production. Never use 0.0.0.0; restrict this port with the host firewall.
TVT_METRICS_LISTEN_HOST=127.0.0.1
TVT_METRICS_LISTEN_PORT=9108
TVT_KUBECONFIG=/etc/tvt/kubeconfig
TVT_SYNC_NAMESPACE=apexfabric
TVT_SYNC_WORKER_ID=tvt-edge
TVT_ROLLOUT_TIMEOUT=180
# Desired-state-only changes may reload without restarting the Pod. The sync
# worker requires the runtime readiness endpoint to acknowledge the exact
# revision within this bound, then falls back to the controlled rollout.
# Set to 0 to disable live reload.
TVT_RUNTIME_RELOAD_TIMEOUT=15
TVT_ENROLLMENT_RECONCILE_INTERVAL_SECONDS=1.0

# Identity resolution (face recognition/enrollment) is opt-in -- see
# apexfabric/control_plane/identity.py:IdentityPolicy.from_environment and
# docs/contracts/tvt-mills-v1/README.md. Set all three together, or leave all
# three unset to disable identity resolution entirely (e.g. an ANPR-only
# deployment). tvt-mills-pilot v1 never emits payload.embeddings.body, so
# APEXFABRIC_BODY_EMBEDDING_DIM is a placeholder -- it just needs to be a
# valid positive integer, since no body vector will ever be validated against
# it.
APEXFABRIC_FACE_EMBEDDING_DIM=512
APEXFABRIC_BODY_EMBEDDING_DIM=1
APEXFABRIC_FACE_MATCH_THRESHOLD=0.6
