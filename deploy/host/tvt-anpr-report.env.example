# TVT daily vehicle-traffic and attendance reports. Replace the email
# placeholders before enabling tvt-anpr-report.timer /
# tvt-anpr-report-attendance.timer. Keep the SendGrid key in the separate
# protected file. Report content is fetched live from apexfabric-control at
# send time (gates only appear once a camera has saved entry/exit lines, see
# a camera's Zones & Lines tab) -- there is no local collector to configure.
TVT_REPORT_APEX_URL=http://127.0.0.1:8088
TVT_REPORT_STATE_DIR=/var/lib/tvt-reporting
TVT_REPORT_TIMEZONE=Asia/Kolkata
TVT_REPORT_WINDOW_START=09:00
TVT_REPORT_WINDOW_END=18:00
TVT_REPORT_RETENTION_DAYS=90

TVT_REPORT_SMTP_HOST=smtp.sendgrid.net
TVT_REPORT_SMTP_PORT=587
TVT_REPORT_SMTP_USERNAME=apikey
TVT_REPORT_SMTP_KEY_FILE=/etc/tvt/anpr-report-sendgrid-key
TVT_REPORT_SMTP_TIMEOUT=15
TVT_REPORT_EMAIL_FROM=sayandiph4@gmail.com
TVT_REPORT_EMAIL_TO=sayandip@apexflo.ai
