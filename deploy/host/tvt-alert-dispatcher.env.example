# Bind to the dedicated host address reachable from the Alertmanager pod network.
TVT_ALERT_LISTEN_HOST=127.0.0.1
TVT_ALERT_LISTEN_PORT=8090
TVT_ALERT_DATABASE_URL=postgresql+psycopg:///tvt
TVT_ALERT_WEBHOOK_TOKEN_FILE=/etc/tvt/alertmanager-webhook.token
TVT_ALERT_SMTP_HOST=smtp.sendgrid.net
TVT_ALERT_SMTP_PORT=587
TVT_ALERT_SMTP_USERNAME=apikey
TVT_ALERT_SMTP_KEY_FILE=/etc/tvt/sendgrid-api-key
# Replace with a SendGrid-verified sender before enabling the service.
TVT_ALERT_EMAIL_FROM=tvt-alerts@tvt.example
TVT_ALERT_POLL_INTERVAL=5
TVT_ALERT_SMTP_TIMEOUT=15
TVT_ALERT_MAX_DELIVERY_AGE=86400
