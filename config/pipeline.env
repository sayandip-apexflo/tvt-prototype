# Immutable TVT Mills pilot delivery. The PIPELINE_TRAFFIC_* variable prefix is
# retained for compatibility with the existing importer, but every value below
# describes the single combined tvt-mills-pilot image that superseded Traffic.
# Public provenance belongs here; credentials belong only in the root-owned
# pipeline credential file.
#
# v2-ungated-enroll (commit 5ad64416, tag tvt-edge-intel-285h-2026.09.18-v2-
# ungated-enroll, published as a proper GitHub Release with an attached
# asset -- superseded the initial 1.9GB commit 6356b7c export, which had an
# accidental double-pack; see CHANGELOG-v2-ungated-enroll.md in TVT_images).
PIPELINE_REPOSITORY=https://github.com/BhashyamDayasagar587/TVT_images.git
PIPELINE_DELIVERY_BRANCH=tvt-edge-intel-285h-2026.09.18-v2-ungated-enroll
PIPELINE_REVISION=5ad64416002dde6bad3ff4577a31372c0d5fad0d
PIPELINE_TRAFFIC_DELIVERY_DIR=.
PIPELINE_TRAFFIC_CATALOG_ID=tvt-mills-pilot:2026.09.18-v2-ungated-enroll
PIPELINE_TRAFFIC_VERSION=2026.09.18-v2-ungated-enroll

# The production path imports this checksum-pinned Linux amd64 OCI archive.
PIPELINE_TRAFFIC_ARCHIVE=tvt-edge-runtime-intel-285h-2026.09.18-v2-ungated-enroll.oci.tar
PIPELINE_TRAFFIC_ARCHIVE_URL=https://github.com/BhashyamDayasagar587/TVT_images/releases/download/tvt-edge-intel-285h-2026.09.18-v2-ungated-enroll/tvt-edge-runtime-intel-285h-2026.09.18-v2-ungated-enroll.oci.tar
PIPELINE_TRAFFIC_ARCHIVE_SHA256=65b6351dead4dd2bc4aa72f13b3ca028f4cd6d76679540eeedbe5ab4b9123c91
PIPELINE_TRAFFIC_ARCHIVE_SIZE=967510016
PIPELINE_TRAFFIC_ARCHIVE_IMAGE=localhost/tvt-edge-runtime:intel-285h-2026.09.18-v2-ungated-enroll

# Versioned edge-local tag. The registry-produced digest is resolved after the
# push and recorded as an immutable repository@sha256 reference.
PIPELINE_TRAFFIC_LOCAL_REPOSITORY=apexfabric/tvt-mills-pilot
PIPELINE_TRAFFIC_LOCAL_TAG=intel-285h-2026.09.18-v2-ungated-enroll

# Checksums bind the importer lock to metadata vendored from the same commit.
PIPELINE_TRAFFIC_CONTRACT_SHA256=3fabd734dfd1b0a18d6dda1e64f0a26f3125f1801bf784e7f423eeb2d4fa93b9
PIPELINE_TRAFFIC_DESIRED_STATE_SCHEMA_SHA256=ad814ea4c29bed685758301b02579cbb6340272397a166a3e5ed73707cf76e64
PIPELINE_TRAFFIC_METRICS_SCHEMA_SHA256=d2be647575d7db4c43b17556ead25fb9103681eb6c946034e1329435f11b40fc
PIPELINE_TRAFFIC_ANALYTICS_EVENT_SCHEMA_SHA256=14250d446b377bf79c6ecf5ae40f168c9071edf2df5d4ac18ff6e8402c6ffde4
PIPELINE_TRAFFIC_ANALYTICS_EVENT_EXAMPLE_SHA256=681d42d8757adda5a23169029461a4503cf600bcc1236d256f38482992e573e8

# Expected v4 OCI/runtime contract. These values are verified without starting
# the CV runtime.
PIPELINE_TRAFFIC_OCI_SOURCE=
PIPELINE_TRAFFIC_OCI_TITLE='TVT Mills Edge Runtime'
PIPELINE_TRAFFIC_CONTRACT_VERSION=tvt-mills-pilot-v1
PIPELINE_TRAFFIC_HARDWARE_PROFILE=intel-285h
PIPELINE_TRAFFIC_MODELS_DELIVERY=baked-in
PIPELINE_TRAFFIC_CONTAINER_USER=10001:10001
PIPELINE_TRAFFIC_CONTAINER_PORT=8080/tcp
PIPELINE_TRAFFIC_CONTAINER_COMMAND='python -m edge'

# TVT-owned compatibility layer for the frozen ApexFabric V1 plan-compiler
# entry point. The vendor runtime watches desired_state.json directly; this
# shim validates that handoff and emits a non-secret receipt for the init gate.
PIPELINE_TRAFFIC_PLAN_COMPILER_COMPATIBILITY_ID=tvt-direct-desired-state-v1
PIPELINE_TRAFFIC_PLAN_COMPILER_SHA256=8f431f567e0474b7f5a84725cb09f47d7cd3c50e5c153173044f60ea46e39f65

# Face-model pins from the same checksum-pinned OCI archive.
PIPELINE_FACE_MODEL_ADAFACE_XML_SHA256=68db3a49803714ec6796f0b9f60a24fa29be0a9d9efa51a76f2dd9bc7e3f959d
PIPELINE_FACE_MODEL_ADAFACE_BIN_SHA256=2e294f66be557edbc14de38f79b8f42c4e52b87bec87e360a3f2fbc7f7242383
PIPELINE_FACE_MODEL_DETECTOR_SHA256=5e4447f50245bbd7966bd6c0fa52938c61474a04ec7def48753668a9d8b4ea3a
PIPELINE_FACE_MODEL_RECOGNIZER_SHA256=df5c06b8a0c12e422b2ed8947b8869faa4105387f199c477af038aa01f9a45cc

# Model files expected in the baked v4 image, with release-published hashes.
PIPELINE_TRAFFIC_MODEL_VEHICLE_XML_SHA256=ba402c4eabe93c1c4ad9b7ea70b95fbb0a0d374b7ec777dc26992f428778f5b9
PIPELINE_TRAFFIC_MODEL_VEHICLE_BIN_SHA256=e8513382b2cca7cc4fb9257a19b0f28156537a1b2e15074fe47fabc64ededf26
PIPELINE_TRAFFIC_MODEL_LICENSE_PLATE_XML_SHA256=d9ff01e97241d2d0132b960d6bd6c12659a09474b3a005991aa633adba0c94aa
PIPELINE_TRAFFIC_MODEL_LICENSE_PLATE_BIN_SHA256=df60a0a27cd91e5cbfe0305f5bce1f8a588acd0b031c3fa2bd4a0c379cc23dda
PIPELINE_TRAFFIC_MODEL_OCR_XML_SHA256=98cdc203e544f3908e8b47da85cb98e771d18de16e877781f7db76dd8feb63ed
PIPELINE_TRAFFIC_MODEL_OCR_BIN_SHA256=96147eba58867c42ba6040f9446a8936d4eecfed14e3e7c2ab43db6bc3f49dff

# Developer-only qualification inputs. Automated synchronization never uses
# source builds because upstream package resolution is not fully immutable.
PIPELINE_UBUNTU_BASE_IMAGE=docker.io/library/ubuntu:24.04@sha256:1e0a86e57d247923571b75e0aaf48a1449cf8c543d51fb3e07a4a7d7bfa79316
PIPELINE_INTEL_NPU_DRIVER_VERSION=1.33.0.20260529-26625960453
