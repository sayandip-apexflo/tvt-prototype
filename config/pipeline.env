# Immutable PIPELINE ApexFabric V1 Traffic delivery. Public provenance belongs
# here; credentials belong only in /etc/tvt/pipeline-image-sync.env.
PIPELINE_REPOSITORY=https://github.com/kiranmaibattu-cyber/PIPELINE.git
PIPELINE_DELIVERY_BRANCH=apexfabric-v1-intel-images
