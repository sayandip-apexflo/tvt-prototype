PIPELINE_TRAFFIC_DELIVERY_DIR=delivery/apexfabric-v1/intel-285h/traffic
PIPELINE_TRAFFIC_CATALOG_ID=traffic-edge-runtime:2026.08.21-v4
PIPELINE_TRAFFIC_VERSION=2026.08.21-v4

# The production path imports this release-authored Linux amd64 Docker archive.
PIPELINE_TRAFFIC_ARCHIVE=image-2026.08.21-v4.tar
PIPELINE_TRAFFIC_ARCHIVE_SHA256=a6787bba6a27bc486f90b4c4dd41681d051c7c834568d99bc4a884d177d10e0f
PIPELINE_TRAFFIC_ARCHIVE_SIZE=1930041856
PIPELINE_TRAFFIC_ARCHIVE_IMAGE=traffic-edge-runtime:intel-285h-2026.08.21-v4

# Versioned edge-local tag. The registry-produced digest is resolved after the
# push and recorded as an immutable repository@sha256 reference.
PIPELINE_TRAFFIC_LOCAL_REPOSITORY=apexfabric/traffic-edge-runtime
PIPELINE_TRAFFIC_LOCAL_TAG=intel-285h-2026.08.21-v4

# Checksums bind the importer lock to metadata vendored from the same commit.
PIPELINE_TRAFFIC_CONTRACT_SHA256=f90f2f7d248531903f13df6249f7192ecbf1e877120522ad0c27d952e9554f08
