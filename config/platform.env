# Frozen TVT V1 platform versions. Shell scripts source only this repository file.
K3S_VERSION=v1.36.3+k3s1
NODE_MANAGEMENT_IMAGE_VERSION=0.1.0

# Docker Hub's linux/amd64 manifest for registry:2.8.3. Keep the tag for
# operator readability and the digest for immutable execution.
LOCAL_REGISTRY_IMAGE=docker.io/library/registry:2.8.3@sha256:46faa9a1ae6813194b53921a370f2f4f8c5e1aae228a89bceafef5847a6a3278
LOCAL_REGISTRY_ADDRESS=127.0.0.1:5000
LOCAL_REGISTRY_DATA_DIR=/var/lib/tvt/registry
LOCAL_REGISTRY_CONTAINER_NAME=tvt-local-registry

# linux/amd64 manifest used by verify-local-registry.sh for its push/pull
# round trip. The local tag is stable so repeated verification is idempotent.
LOCAL_REGISTRY_SMOKE_IMAGE=docker.io/library/busybox:1.36.1@sha256:b7f3d86d6e84fc17718c48bcde1450807faa2d56704205c697b4bd5df7b9e29f
LOCAL_REGISTRY_SMOKE_REPOSITORY=tvt/registry-smoke
LOCAL_REGISTRY_SMOKE_TAG=busybox-1.36.1-amd64
