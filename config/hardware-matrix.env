# Pinned TVT V1 edge hardware matrix. Shell scripts source only this file.
# The inventory records the exact target kernel. linux-headers track it
# exactly, and the edge installer fails if the host drifts before install.
HARDWARE_PROFILE=intel-285h
MINIMUM_KERNEL=6.8

# Axelera Metis/Voyager compatibility line. Present only when the edge probe
# reports Axelera PCI hardware (vendor 0x1f9d); Intel-only bundles must not
# contain Metis or Voyager artifacts.
METIS_DKMS_VERSION=1.4.17
VOYAGER_RUNTIME_VERSION=1.6.1
METIS_FIRMWARE_RECOMMENDED=1.6.0
METIS_BOARD_CONTROLLER_RECOMMENDED=7.4

# The Intel NPU release stays pinned via PIPELINE_INTEL_NPU_DRIVER_VERSION in
# config/pipeline.env; this matrix only gates the minimum qualified kernel.
