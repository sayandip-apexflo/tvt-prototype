{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": [
    "edge_id",
    "revision",
    "cameras"
  ],
  "additionalProperties": false,
  "properties": {
    "edge_id": {
      "type": "string",
      "minLength": 1
    },
    "revision": {
      "type": "integer",
      "minimum": 1
    },
    "cameras": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "camera_id",
          "source",
          "apps"
        ],
        "additionalProperties": false,
        "properties": {
          "camera_id": {
            "type": "string",
            "minLength": 1
          },
          "name": {
            "type": "string"
          },
          "source": {
            "type": "string",
            "pattern": "^file:"
          },
          "fps": {
            "type": "number",
            "exclusiveMinimum": 0
          },
          "apps": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "enum": [
                "vehicle_counting",
                "pedestrian_counting",
                "anpr",
                "plate_detection",
                "fire_smoke_detection"
              ]
            }
          },
          "config": {
            "type": "object"
          },
          "solution_pack": {
            "type": "string"
          }
        }
      }
    }
  }
}
