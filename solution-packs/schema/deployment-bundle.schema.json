{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://apexfabric.local/schemas/deployment-bundle-1.0.0.json",
  "title": "ApexFabric Deployment Bundle",
  "description": "Kubernetes-independent desired state for an ApexFabric solution deployment.",
  "type": "object",
  "additionalProperties": false,
  "required": ["api_version", "kind", "deployment_id", "solution", "applications"],
  "properties": {
    "api_version": {"const": "apexfabric.com/v1alpha1"},
    "kind": {"const": "DeploymentBundle"},
    "deployment_id": {"$ref": "#/$defs/id"},
    "solution": {
      "type": "object",
      "additionalProperties": false,
      "required": ["solution_id", "version"],
      "properties": {
        "solution_id": {"$ref": "#/$defs/id"},
        "version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(?:[-+][0-9A-Za-z.-]+)?$"}
      }
    },
    "applications": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/application"}
    },
    "configuration": {"type": "object"}
  },
  "$defs": {
    "id": {"type": "string", "pattern": "^[a-z0-9]([a-z0-9.-]{0,61}[a-z0-9])?$"},
    "quantity": {"type": "string", "pattern": "^(?:[1-9][0-9]*|[0-9]+m|[1-9][0-9]*(?:Ki|Mi|Gi|Ti))$"},
    "application": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "image", "resources", "cameras", "health", "ports"],
      "properties": {
        "name": {"$ref": "#/$defs/id"},
        "image": {
          "type": "object",
          "additionalProperties": false,
          "required": ["repository", "tag"],
          "properties": {
            "repository": {"type": "string", "minLength": 1, "pattern": "^[^@\\s]+$"},
            "tag": {"type": "string", "minLength": 1, "pattern": "^[A-Za-z0-9_][A-Za-z0-9_.-]{0,127}$"},
            "digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
            "pull_policy": {"enum": ["Always", "IfNotPresent", "Never"], "default": "IfNotPresent"}
          }
        },
        "replicas": {"type": "integer", "minimum": 1, "default": 1},
        "lifecycle": {
          "type": "object", "additionalProperties": false,
          "properties": {
            "desired_state": {"enum": ["Running", "Stopped"], "default": "Running"},
            "termination_grace_period_seconds": {"type": "integer", "minimum": 1, "maximum": 600, "default": 30}
          }
        },
        "resources": {
          "type": "object",
          "additionalProperties": false,
          "required": ["cpu", "memory", "accelerators"],
          "properties": {
            "cpu": {
              "type": "object", "additionalProperties": false, "required": ["request", "limit"],
              "properties": {"request": {"$ref": "#/$defs/quantity"}, "limit": {"$ref": "#/$defs/quantity"}}
            },
            "memory": {
              "type": "object", "additionalProperties": false, "required": ["request", "limit"],
              "properties": {"request": {"$ref": "#/$defs/quantity"}, "limit": {"$ref": "#/$defs/quantity"}}
            },
            "accelerators": {
              "type": "object", "additionalProperties": false, "required": ["decoder", "metis"],
              "properties": {
                "decoder": {"type": "integer", "minimum": 0},
                "metis": {"type": "integer", "minimum": 0}
              }
            },
            "camera_streams": {"type": "integer", "minimum": 0}
          }
        },
        "cameras": {
          "type": "array", "uniqueItems": true,
          "items": {"$ref": "#/$defs/id"}
        },
        "camera_contract": {
          "type": "object", "additionalProperties": false,
          "required": ["configuration_owner", "transport", "required_for_readiness"],
          "properties": {
            "configuration_owner": {"enum": ["platform", "application-api"]},
            "transport": {"enum": ["rtsp", "file", "mixed"]},
            "required_for_readiness": {"type": "boolean"},
            "scheduling_mode": {"enum": ["node-locality", "runtime-connectivity"], "default": "runtime-connectivity"}
          }
        },
        "configuration": {"type": "object"},
        "placement": {
          "type": "object", "additionalProperties": false,
          "properties": {
            "runtime_profile": {"enum": ["standard", "intel-285h-metis", "intel-285h-gpu-npu"], "default": "standard"},
            "node_class": {"$ref": "#/$defs/id"},
            "architecture": {"enum": ["amd64", "arm64"]},
            "requires_qualified_node": {"type": "boolean", "default": true},
            "requires_camera_labels": {"type": "boolean", "default": true},
            "characteristics": {
              "type": "object",
              "additionalProperties": {"type": "string", "minLength": 1}
            }
          }
        },
        "persistent_volumes": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["name", "mount_path", "size"],
            "properties": {
              "name": {"$ref": "#/$defs/id"},
              "mount_path": {"type": "string", "pattern": "^/[^:]*$"},
              "size": {"$ref": "#/$defs/quantity"},
              "storage_class": {"$ref": "#/$defs/id"}
            }
          }
        },
        "external_mounts": {
          "type": "array",
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/external_mount"}
        },
        "plan_compiler": {
          "type": "object",
          "additionalProperties": false,
          "required": ["type", "desired_state_secret", "desired_state_key"],
          "properties": {
            "type": {"const": "edge-agent-v1"},
            "desired_state_secret": {"$ref": "#/$defs/id"},
            "desired_state_key": {"type": "string", "pattern": "^[A-Za-z0-9._-]+$"}
          }
        },
        "health": {
          "type": "object", "additionalProperties": false, "required": ["readiness", "liveness"],
          "properties": {
            "readiness": {"$ref": "#/$defs/health_endpoint"},
            "liveness": {"$ref": "#/$defs/health_endpoint"},
            "startup": {"$ref": "#/$defs/health_endpoint"}
          }
        },
        "ports": {
          "type": "array", "uniqueItems": true,
          "items": {
            "type": "object", "additionalProperties": false, "required": ["name", "container_port"],
            "properties": {
              "name": {"$ref": "#/$defs/id"},
              "container_port": {"type": "integer", "minimum": 1, "maximum": 65535},
              "protocol": {"enum": ["TCP", "UDP"], "default": "TCP"}
            }
          }
        },
        "telemetry": {
          "type": "object", "additionalProperties": false,
          "properties": {
            "metrics": {
              "type": "object", "additionalProperties": false, "required": ["path", "port", "format"],
              "properties": {
                "path": {"type": "string", "pattern": "^/"},
                "port": {"type": "string", "minLength": 1},
                "format": {"enum": ["prometheus", "json"]}
              }
            },
            "events": {
              "type": "object", "additionalProperties": false, "required": ["path", "port", "protocol"],
              "properties": {
                "path": {"type": "string", "pattern": "^/"},
                "port": {"type": "string", "minLength": 1},
                "protocol": {"enum": ["websocket", "http", "sse"]}
              }
            }
          }
        },
        "environment": {
          "type": "object",
          "propertyNames": {"pattern": "^[A-Z_][A-Z0-9_]*$"},
          "additionalProperties": {"type": "string"}
        },
        "secrets": {
          "type": "object",
          "propertyNames": {"pattern": "^[A-Za-z0-9._-]+$"},
          "additionalProperties": {"type": "string"}
        },
        "secret_environment": {
          "type": "object",
          "propertyNames": {"pattern": "^[A-Z_][A-Z0-9_]*$"},
          "additionalProperties": {"type": "string", "pattern": "^[A-Za-z0-9._-]+$"}
        }
      }
    },
    "health_endpoint": {
      "type": "object", "additionalProperties": false, "required": ["path", "port"],
      "properties": {
        "path": {"type": "string", "pattern": "^/"},
        "port": {"type": "string", "minLength": 1},
        "initial_delay_seconds": {"type": "integer", "minimum": 0},
        "period_seconds": {"type": "integer", "minimum": 1},
        "timeout_seconds": {"type": "integer", "minimum": 1},
        "failure_threshold": {"type": "integer", "minimum": 1}
      }
    },
    "external_mount": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "mount_path", "read_only", "source"],
      "properties": {
        "name": {"$ref": "#/$defs/id"},
        "mount_path": {"type": "string", "pattern": "^/[^:]*$"},
        "read_only": {"type": "boolean"},
        "source": {
          "oneOf": [
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["type", "name", "key"],
              "properties": {
                "type": {"const": "secret"},
                "name": {"$ref": "#/$defs/id"},
                "key": {"type": "string", "pattern": "^[A-Za-z0-9._-]+$"}
              }
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["type", "name"],
              "properties": {
                "type": {"const": "persistent_volume_claim"},
                "name": {"$ref": "#/$defs/id"}
              }
            }
          ]
        }
      }
    }
  }
}
