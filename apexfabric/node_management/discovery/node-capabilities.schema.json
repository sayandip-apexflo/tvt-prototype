{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://apexfabric.local/schemas/node-capabilities-1.1.0.json",
  "title": "ApexFabric Node Capabilities",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "node_id", "hardware", "accelerators", "decoder", "cameras", "network", "software"],
  "properties": {
    "schema_version": {"const": "1.1.0"},
    "node_id": {"type": "string", "minLength": 1},
    "hardware": {"type": "object", "required": ["cpu", "memory", "storage"]},
    "accelerators": {"type": "object", "required": ["gpu", "metis"]},
    "decoder": {"type": "object", "required": ["va_api", "gstreamer", "gstreamer_decoder_elements"]},
    "cameras": {
      "type": "object",
      "required": ["accessible", "source"],
      "properties": {
        "accessible": {"type": "array", "uniqueItems": true, "items": {"type": "string", "pattern": "^[a-z0-9]([a-z0-9.-]*[a-z0-9])?$"}},
        "source": {"type": ["string", "null"]},
        "error": {"type": "string"}
      }
    },
    "network": {"type": "object", "required": ["interfaces", "default_routes", "probe_status", "connectivity"]},
    "software": {"type": "object", "required": ["os", "kernel", "container_runtimes", "gstreamer", "k3s", "voyager_sdk"]}
  }
}
