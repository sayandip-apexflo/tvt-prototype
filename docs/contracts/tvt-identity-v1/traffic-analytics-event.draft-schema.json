{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://apexfabric.local/schemas/v1/traffic-analytics-event.json",
  "title": "ApexFabric Traffic Analytics Event V1 (draft: +location for direction)",
  "description": "Draft delta over the pinned solution-packs/catalog/traffic-edge-runtime-2026.08.21-v4/analytics-event.schema.json. Adds a documented payload.location for plate_read_event so vehicle-traffic reporting can derive entry/exit direction from which zone (config.zones.anpr[], named '<gate>_entry'/'<gate>_exit') a plate was read in. Not promoted; do not overwrite the pinned v4 file with this.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "event_id", "timestamp", "camera_id", "solution_pack", "application", "event_type", "payload"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "event_id": {"type": "string", "minLength": 1},
    "timestamp": {"type": "string", "format": "date-time"},
    "camera_id": {"type": "string", "minLength": 1},
    "solution_pack": {"const": "traffic"},
    "application": {"enum": ["anpr", "wrong_way", "vehicle_counting", "pedestrian_counting", "illegal_parking"]},
    "event_type": {"enum": ["plate_read_event", "wrong_way_event", "vehicle_count_event", "pedestrian_count_event", "illegal_parking_event"]},
    "payload": {
      "type": "object",
      "properties": {
        "vehicle_ref": {"type": "string", "minLength": 1},
        "vehicle_track_id": {"type": ["integer", "string"]},
        "vehicle": {"$ref": "#/$defs/vehicle"},
        "plate": {"$ref": "#/$defs/plate"},
        "location": {"$ref": "#/$defs/location"},
        "snapshot_ref": {"type": "string", "minLength": 1},
        "snapshot_url": {"type": "string", "pattern": "^/snapshots/"},
        "snapshot_content_type": {"type": "string", "minLength": 1},
        "snapshot_assets": {
          "type": "object",
          "additionalProperties": {"$ref": "#/$defs/snapshot_asset"}
        }
      },
      "additionalProperties": true
    }
  },
  "$defs": {
    "plate": {
      "type": "object",
      "required": ["text"],
      "properties": {
        "text": {"type": "string", "minLength": 1},
        "confidence": {"type": "number", "minimum": 0, "maximum": 1}
      },
      "additionalProperties": true
    },
    "vehicle": {
      "type": "object",
      "required": ["ref", "track_id", "camera_id"],
      "properties": {
        "ref": {"type": "string", "minLength": 1},
        "track_id": {"type": ["integer", "string"]},
        "camera_id": {"type": "string", "minLength": 1},
        "plate": {"$ref": "#/$defs/plate"}
      },
      "additionalProperties": true
    },
    "location": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "type"],
      "description": "Populated only for anpr cameras with entry/exit zone pairs (config.zones.anpr[], named '<gate>_entry'/'<gate>_exit'). No direction field: the control plane derives direction from which zone id this names.",
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "name": {"type": "string"},
        "type": {"const": "zone"}
      }
    },
    "snapshot_asset": {
      "type": "object",
      "required": ["ref", "url", "content_type"],
      "properties": {
        "ref": {"type": "string", "minLength": 1},
        "url": {"type": "string", "pattern": "^/snapshots/"},
        "content_type": {"type": "string", "minLength": 1}
      },
      "additionalProperties": false
    }
  }
}
